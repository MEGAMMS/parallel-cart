# Maven / Java build output
/target/
**/target/
!src/**/target/
*.class

# Maven wrapper files should stay visible when present
!.mvn/wrapper/maven-wrapper.properties
!.mvn/wrapper/maven-wrapper.jar

# Generated logs, dumps, and profiling artifacts
*.log
*.hprof
*.jfr
hs_err_pid*
replay_pid*

# Local environment and secrets
.env
.env.*
!.env.example

# JMeter/performance output
/apache-jmeter-*/
/apache-jmeter-*.zip
/jmeter.log
*.jtl

# Keep small benchmark/bottleneck summaries in reports, ignore generated dashboards/raw runs
/reports/jmeter/**
!/reports/jmeter/
!/reports/jmeter/git-before-after-summary.md
/reports/**/checkout-dashboard/
/reports/**/read-dashboard/
/reports/**/before-checkout-dashboard/
/reports/**/before-read-dashboard/
/reports/**/after-checkout-dashboard/
/reports/**/after-read-dashboard/
/reports/**/fixed-checkout-dashboard/
/reports/jmeter/git-history-*/
/reports/jmeter/git-before/
/reports/jmeter/git-after/

# Local report exports at repository root
/parallel-cart-output.*


# OS files
.DS_Store
Thumbs.db

# STS / Eclipse
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
/build/
**/build/
!src/**/build/

# VS Code
.vscode/
